[
  {
    "name": "replaces relative exact text through FileMutation once",
    "fixtures": [
      {
        "path": "{{root}}/hello.txt",
        "parts": [
          {
            "text": "before\nrest\n"
          }
        ]
      }
    ],
    "call": {
      "path": "hello.txt",
      "oldString": "before",
      "newString": "after"
    },
    "expected": {
      "status": "completed",
      "output": "Edited hello.txt (1 replacement)",
      "content": [
        {
          "type": "text",
          "text": "Edited hello.txt (1 replacement)"
        }
      ],
      "metadata": {
        "files": [
          {
            "file": "hello.txt",
            "patch": "Index: hello.txt\n===================================================================\n--- hello.txt\n+++ hello.txt\n@@ -1,2 +1,2 @@\n-before\n+after\n rest\n",
            "status": "modified",
            "additions": 1,
            "deletions": 1
          }
        ]
      },
      "assertions": [
        {
          "action": "edit",
          "resources": [
            "hello.txt"
          ],
          "save": [
            "*"
          ],
          "metadata": {
            "files": [
              {
                "file": "hello.txt",
                "patch": "Index: hello.txt\n===================================================================\n--- hello.txt\n+++ hello.txt\n@@ -1,2 +1,2 @@\n-before\n+after\n rest\n",
                "status": "modified",
                "additions": 1,
                "deletions": 1
              }
            ]
          }
        }
      ],
      "tree": {
        "{{root}}/hello.txt": "YWZ0ZXIKcmVzdAo="
      }
    }
  },
