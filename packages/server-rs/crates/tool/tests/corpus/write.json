[
  {
    "name": "creates a relative file through FileMutation once",
    "call": {
      "path": "src/new.txt",
      "content": "created"
    },
    "fixtures": [],
    "expected": {
      "status": "completed",
      "output": "Created file successfully: src/new.txt",
      "content": [
        {
          "type": "text",
          "text": "Created file successfully: src/new.txt"
        }
      ],
      "assertions": [
        {
          "action": "edit",
          "resources": [
            "src/new.txt"
          ],
          "save": [
            "*"
          ],
          "metadata": {
            "files": [
              {
                "file": "src/new.txt",
                "patch": "Index: src/new.txt\n===================================================================\n--- src/new.txt\n+++ src/new.txt\n@@ -0,0 +1,1 @@\n+created\n\\ No newline at end of file\n",
                "status": "added",
                "additions": 1,
                "deletions": 0
              }
            ]
          }
        }
      ],
      "tree": {
        "{{root}}/src": null,
        "{{root}}/src/new.txt": "Y3JlYXRlZA=="
      }
    }
  },
  {
    "name": "overwrites a relative existing file and reports that it wrote the file",
    "fixtures": [
      {
        "path": "{{root}}/existing.txt",
        "parts": [
          {
            "text": "before"
          }
        ]
      }
    ],
    "call": {
      "path": "existing.txt",
      "content": "after"
    },
    "expected": {
      "status": "completed",
      "output": "Wrote file successfully: existing.txt",
      "content": [
        {
          "type": "text",
          "text": "Wrote file successfully: existing.txt"
        }
      ],
      "assertions": [
        {
          "action": "edit",
          "resources": [
            "existing.txt"
          ],
          "save": [
            "*"
          ],
          "metadata": {
            "files": [
              {
                "file": "existing.txt",
                "patch": "Index: existing.txt\n===================================================================\n--- existing.txt\n+++ existing.txt\n@@ -1,1 +1,1 @@\n-before\n\\ No newline at end of file\n+after\n\\ No newline at end of file\n",
                "status": "modified",
                "additions": 1,
                "deletions": 1
              }
            ]
          }
        }
      ],
      "tree": {
        "{{root}}/existing.txt": "YWZ0ZXI="
      }
    }
  },
