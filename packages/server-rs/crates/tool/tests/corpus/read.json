[
  {
    "name": "reads and authorizes through the location filesystem",
    "fixtures": [
      {
        "path": "{{root}}/README.md",
        "parts": [
          {
            "text": "hello"
          }
        ]
      }
    ],
    "call": {
      "path": "README.md"
    },
    "expected": {
      "status": "completed",
      "output": {
        "type": "text",
        "content": "hello",
        "offset": 1,
        "lineCount": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Read file README.md, lines 1-1\n1: hello"
        }
      ],
      "metadata": {
        "truncated": false
      },
      "assertions": [
        {
          "action": "read",
          "resources": [
            "README.md"
          ],
          "save": [
            "*"
          ]
        }
      ],
      "loaded": [],
      "tree": {
        "{{root}}/README.md": "aGVsbG8="
      }
    }
  },
  {
    "name": "rejects a zero limit before reading",
    "fixtures": [
      {
        "path": "{{root}}/README.md",
        "parts": [
          {
            "text": "hello"
          }
        ]
      }
    ],
    "call": {
      "path": "README.md",
      "limit": 0
    },
    "expected": {
      "status": "error",
      "error": "Limit must be a positive integer",
      "assertions": [],
      "loaded": [],
      "tree": {
        "{{root}}/README.md": "aGVsbG8="
      }
    }
  },
  {
    "name": "does not read when permission is denied",
    "fixtures": [
      {
        "path": "{{root}}/README.md",
        "parts": [
          {
            "text": "hello"
          }
        ]
      }
    ],
    "call": {
      "path": "README.md"
    },
    "permission": {
      "allow": false
    },
    "expected": {
      "status": "error",
      "error": "Permission denied: read",
      "assertions": [
        {
          "action": "read",
          "resources": [
            "README.md"
          ],
          "save": [
            "*"
          ]
        }
      ],
      "loaded": [],
      "tree": {
        "{{root}}/README.md": "aGVsbG8="
      }
    }
  },
  {
    "name": "asks for external approval before reading an external path",
    "fixtures": [
      {
        "path": "{{outside}}/notes.txt",
        "parts": [
