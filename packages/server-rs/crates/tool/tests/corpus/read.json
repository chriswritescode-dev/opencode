  {
    "name": "lists a bounded directory page",
    "fixtures": [
      {
        "path": "{{root}}/src/assets",
        "kind": "directory"
      },
      {
        "path": "{{root}}/src/components",
        "kind": "directory"
      },
      {
        "path": "{{root}}/src/index.ts",
        "parts": [
          {
            "text": "x\n"
          }
        ]
      },
      {
        "path": "{{root}}/src/z1.ts",
        "parts": [
          {
            "text": "x\n"
          }
        ]
      },
      {
        "path": "{{root}}/src/z2.ts",
        "parts": [
          {
            "text": "x\n"
          }
        ]
      }
    ],
    "call": {
      "path": "src",
      "offset": 2,
      "limit": 2
