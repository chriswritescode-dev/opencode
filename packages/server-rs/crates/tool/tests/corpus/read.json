      "status": "completed",
      "output": {
        "type": "text",
        "content": "hello",
        "offset": 1,
        "lineCount": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Read file {{outside}}/notes.txt, lines 1-1\n1: hello"
        }
      ],
      "metadata": {
        "truncated": false
      },
      "assertions": [
