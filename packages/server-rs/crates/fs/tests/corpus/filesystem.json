[
  {
    "name": "read-text",
    "kind": "read",
    "location": ".",
    "fixture": {
      "files": [
        {
          "path": "text.txt",
          "text": "hello"
        }
      ]
    },
    "input": "text.txt",
    "expected": {
      "mime": "text/plain",
      "size": 5,
      "mtime": true,
      "bytes": "aGVsbG8="
    }
  },
  {
    "name": "read-binary",
    "kind": "read",
    "location": ".",
    "fixture": {
      "files": [
        {
          "path": "data.bin",
          "base64": "AAECAwQ="
        }
      ]
    },
    "input": "data.bin",
    "expected": {
      "mime": "application/octet-stream",
      "size": 5,
      "mtime": true,
      "bytes": "AAECAwQ="
    }
  },
  {
    "name": "read-range",
    "kind": "read",
    "location": ".",
    "fixture": {
      "files": [
        {
          "path": "data.bin",
          "base64": "AAECAwQ="
        }
      ]
    },
    "input": "data.bin",
    "range": {
      "offset": 1,
      "bytesToRead": 3
    },
    "expected": {
      "mime": "application/octet-stream",
      "size": 5,
      "mtime": true,
      "bytes": "AQID"
    }
  },
  {
    "name": "read-lexical-escape",
    "kind": "read",
    "location": "current",
    "fixture": {
      "dirs": [
        "current"
      ],
      "files": [
        {
          "path": "outside.txt",
          "text": "outside"
        }
      ]
    },
    "input": "../outside.txt",
    "expected": {
      "error": "FileSystem.NotFoundError"
    }
  },
  {
    "name": "read-nul",
    "kind": "read",
    "location": ".",
    "fixture": {
      "files": [
        {
          "path": "text.txt",
          "text": "hello"
        }
      ]
    },
    "input": "te\u0000xt",
    "expected": {
      "error": "FileSystem.NotFoundError"
    }
  },
  {
    "name": "read-symlink-escape",
    "kind": "read",
    "location": "current",
    "fixture": {
      "dirs": [
        "current",
        "outside"
      ],
      "files": [
        {
          "path": "outside/file.txt",
          "text": "outside"
        }
      ],
      "symlinks": [
        {
          "path": "current/link",
          "target": "../outside"
        }
      ]
    },
    "input": "link/file.txt",
    "expected": {
      "error": "FileSystem.NotFoundError"
    }
  },
  {
    "name": "read-missing",
