{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["script", "test", "host", "parity"],
  "exclude": [
    "script/config-corpus",
    "script/fs-corpus",
    "script/registry-corpus",
    "script/shell-corpus",
    "script/tool-corpus",
    "script/tool-definitions",
    "script/vcs-corpus"
  ]
}
